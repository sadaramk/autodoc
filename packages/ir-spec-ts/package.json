{
  "name": "@nunki/ir-spec",
  "version": "0.1.0",
  "description": "TypeScript + zod mirror of the nunki DiagramIR",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
